# 复制为 deploy/.env 后填写真实值。不要提交 deploy/.env。

# ---- 数据库 ----
MYSQL_ROOT_PASSWORD=change-me-strong-db-password
DB_USERNAME=root
DB_PASSWORD=change-me-strong-db-password

# ---- 应用 ----
JWT_SECRET=change-me-to-at-least-32-bytes-random-secret
# 管理后台浏览器访问来源，用于 CORS（无尾斜杠）
ADMIN_ORIGIN=https://admin.example.com

# ---- 腾讯云 COS ----
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET=your-bucket-1250000000
# 公网访问前缀，无尾斜杠。可用默认桶域名或 CDN 域名
# 例：https://your-bucket-1250000000.cos.ap-guangzhou.myqcloud.com
COS_PUBLIC_BASE_URL=

# ---- 对外 API（给小程序 / admin 构建用，无尾斜杠）----
# 若 Nginx 与域名同机且反代 /api，可写 https://api.example.com
PUBLIC_API_ORIGIN=https://api.example.com

# ---- 微信小程序（文章插入「扫码进视频详情」小程序码）----
# 与 project.config.json 的 appid 一致；Secret 在微信公众平台 → 开发管理 → 开发设置
WECHAT_MINIAPP_APP_ID=wxe969f08ccf80e103
WECHAT_MINIAPP_APP_SECRET=
# release | trial | develop
WECHAT_MINIAPP_ENV_VERSION=release
# 生产必须为 false；仅本地无密钥联调时可 true
WECHAT_MINIAPP_MOCK=false
