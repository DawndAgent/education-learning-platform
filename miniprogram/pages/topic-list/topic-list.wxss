.topic-card {
  display: block;
  margin-top: 20rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
}

.cover {
  width: 100%;
  height: 280rpx;
  border-radius: 12rpx;
  background: #eef2f6;
}

.cover-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8f959e;
  font-size: 24rpx;
}

.name {
  margin-top: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.meta {
  margin-top: 8rpx;
  color: #646a73;
  font-size: 24rpx;
}

.summary {
  margin-top: 8rpx;
  color: #646a73;
  font-size: 26rpx;
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.footer {
  margin-top: 24rpx;
  text-align: center;
  color: #8f959e;
  font-size: 24rpx;
}

.footer.error {
  color: #d4380d;
}
