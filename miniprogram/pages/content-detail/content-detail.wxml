<view class="page">
  <view class="back" bindtap="goBack">返回</view>

  <loading-view wx:if="{{status === 'loading'}}" message="加载中..." />

  <block wx:elif="{{status === 'error'}}">
    <error-view wx:if="{{canRetry}}" message="{{message}}" button-text="重新加载" bind:retry="loadDetail" />
    <view wx:else class="message">{{message}}</view>
  </block>

  <block wx:elif="{{status === 'unsupported'}}">
    <view class="title" wx:if="{{title}}">{{title}}</view>
    <view class="message">{{message}}</view>
  </block>

  <block wx:elif="{{kind === 'article'}}">
    <view class="title">{{title}}</view>
    <view class="meta" wx:if="{{author}}">作者：{{author}}</view>
    <view class="meta" wx:if="{{source}}">来源：{{source}}</view>
    <view class="meta" wx:if="{{dateText}}">{{dateText}}</view>
    <image wx:if="{{coverUrl}}" class="cover" src="{{coverUrl}}" mode="widthFix" />
    <view wx:else class="cover cover-fallback">暂无封面</view>
    <view class="summary" wx:if="{{summary}}">{{summary}}</view>
    <rich-text wx:if="{{bodyHtml}}" class="body" nodes="{{bodyHtml}}" />
  </block>

  <block wx:elif="{{kind === 'video'}}">
    <view class="title">{{title}}</view>
    <video
      wx:if="{{playUrl}}"
      class="player"
      src="{{playUrl}}"
      poster="{{coverUrl}}"
      controls
      show-center-play-btn
      object-fit="contain"
    />
    <block wx:else>
      <image wx:if="{{coverUrl}}" class="cover video-cover" src="{{coverUrl}}" mode="aspectFill" />
      <view wx:else class="cover video-cover cover-fallback">暂无封面</view>
    </block>
    <view class="source" wx:if="{{sourceLabel}}">{{sourceLabel}}</view>
    <view class="summary" wx:if="{{summary}}">{{summary}}</view>
    <image
      wx:if="{{!playUrl && qrCodeUrl}}"
      class="qr"
      src="{{qrCodeUrl}}"
      mode="aspectFit"
      bindtap="previewQr"
    />
    <view class="hint" wx:if="{{watchHint}}">{{watchHint}}</view>
    <view class="meta" wx:if="{{durationText}}">时长：{{durationText}}</view>
    <view class="meta" wx:if="{{dateText}}">{{dateText}}</view>
  </block>

  <block wx:elif="{{kind === 'question'}}">
    <view class="title">{{title}}</view>
    <view class="meta" wx:if="{{categoryText}}">分类：{{categoryText}}</view>
    <view class="meta" wx:if="{{dateText}}">{{dateText}}</view>
    <image wx:if="{{coverUrl}}" class="cover" src="{{coverUrl}}" mode="widthFix" />
    <view class="summary" wx:if="{{summary}}">{{summary}}</view>
    <view class="section-title">题目</view>
    <view class="question-text" wx:if="{{questionText}}">{{questionText}}</view>
    <image
      wx:if="{{questionImageUrl}}"
      class="media"
      src="{{questionImageUrl}}"
      mode="widthFix"
      bindtap="previewQuestionImage"
    />
    <view wx:if="{{hasAnswer}}" class="fold" bindtap="toggleAnswer">
      <text>{{answerExpanded ? '收起答案' : '查看答案'}}</text>
    </view>
    <view wx:if="{{hasAnswer && answerExpanded}}" class="fold-body">
      <view class="question-text" wx:if="{{answerText}}">{{answerText}}</view>
      <image
        wx:if="{{answerImageUrl}}"
        class="media"
        src="{{answerImageUrl}}"
        mode="widthFix"
        bindtap="previewAnswerImage"
      />
    </view>
    <view wx:if="{{hasAnalysis}}" class="fold" bindtap="toggleAnalysis">
      <text>{{analysisExpanded ? '收起解析' : '查看解析'}}</text>
    </view>
    <view wx:if="{{hasAnalysis && analysisExpanded}}" class="fold-body">
      <view class="question-text" wx:if="{{analysisText}}">{{analysisText}}</view>
      <image
        wx:if="{{analysisImageUrl}}"
        class="media"
        src="{{analysisImageUrl}}"
        mode="widthFix"
        bindtap="previewAnalysisImage"
      />
    </view>
  </block>

  <block wx:elif="{{kind === 'weekly'}}">
    <view class="title">{{title}}</view>
    <view class="week-label" wx:if="{{weekLabel}}">{{weekLabel}}</view>
    <view class="meta" wx:if="{{categoryText}}">分类：{{categoryText}}</view>
    <view class="meta" wx:if="{{dateText}}">{{dateText}}</view>
    <image wx:if="{{coverUrl}}" class="cover" src="{{coverUrl}}" mode="widthFix" />
    <view class="summary" wx:if="{{summary}}">{{summary}}</view>
    <view class="section-title">题目</view>
    <view class="question-text" wx:if="{{questionText}}">{{questionText}}</view>
    <image
      wx:if="{{questionImageUrl}}"
      class="media"
      src="{{questionImageUrl}}"
      mode="widthFix"
      bindtap="previewQuestionImage"
    />
    <view wx:if="{{hasAnswer}}" class="fold" bindtap="toggleAnswer">
      <text>{{answerExpanded ? '收起答案' : '查看答案'}}</text>
    </view>
    <view wx:if="{{hasAnswer && answerExpanded}}" class="fold-body">
      <view class="question-text" wx:if="{{answerText}}">{{answerText}}</view>
      <image
        wx:if="{{answerImageUrl}}"
        class="media"
        src="{{answerImageUrl}}"
        mode="widthFix"
        bindtap="previewAnswerImage"
      />
    </view>
    <view wx:if="{{hasAnalysis}}" class="fold" bindtap="toggleAnalysis">
      <text>{{analysisExpanded ? '收起解析' : '查看解析'}}</text>
    </view>
    <view wx:if="{{hasAnalysis && analysisExpanded}}" class="fold-body">
      <view class="question-text" wx:if="{{analysisText}}">{{analysisText}}</view>
      <image
        wx:if="{{analysisImageUrl}}"
        class="media"
        src="{{analysisImageUrl}}"
        mode="widthFix"
        bindtap="previewAnalysisImage"
      />
    </view>
  </block>

  <block wx:elif="{{kind === 'document'}}">
    <view class="title">{{title}}</view>
    <view class="meta" wx:if="{{categoryText}}">分类：{{categoryText}}</view>
    <view class="meta" wx:if="{{dateText}}">{{dateText}}</view>
    <image wx:if="{{coverUrl}}" class="cover" src="{{coverUrl}}" mode="widthFix" />
    <view class="summary" wx:if="{{summary}}">{{summary}}</view>
    <view class="doc-card">
      <view class="doc-row" wx:if="{{fileName}}">文件名：{{fileName}}</view>
      <view class="doc-row" wx:if="{{fileSizeText}}">大小：{{fileSizeText}}</view>
      <view class="doc-row" wx:if="{{fileType}}">类型：{{fileType}}</view>
      <view class="doc-row" wx:if="{{description}}">{{description}}</view>
    </view>
    <view class="doc-actions">
      <button class="doc-btn" bindtap="previewDocument">在线预览</button>
      <button class="doc-btn doc-btn-secondary" bindtap="downloadDocument">下载资料</button>
    </view>
  </block>
</view>
