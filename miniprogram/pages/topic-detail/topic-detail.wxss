.back {
  color: #2f6f62;
  margin-bottom: 16rpx;
}

.cover {
  display: block;
  width: 100%;
  height: 360rpx;
  border-radius: 16rpx;
  background: #eef2f6;
}

.cover-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8f959e;
}

.name {
  margin-top: 24rpx;
  font-size: 40rpx;
  font-weight: 600;
}

.content-row {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
}

.index {
  flex: none;
  width: 48rpx;
  margin-top: 28rpx;
  color: #8f959e;
  font-size: 28rpx;
  font-weight: 600;
}

.content-row content-card {
  flex: 1;
  min-width: 0;
}

.meta {
  margin-top: 12rpx;
  color: #646a73;
}

.summary {
  margin-top: 12rpx;
  color: #646a73;
  line-height: 1.6;
}

.section {
  margin-top: 40rpx;
  margin-bottom: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
}
