.card {
  display: flex;
  align-items: flex-start;
  margin-top: 20rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
}

.cover {
  flex: none;
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #eef2f6;
}

.cover-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8f959e;
  font-size: 22rpx;
}

.card-stack {
  flex-direction: column;
}

.card-stack .cover {
  width: 100%;
  height: 360rpx;
}

.card-stack .body {
  width: 100%;
  margin-top: 16rpx;
  margin-left: 0;
}

.body {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.title {
  display: -webkit-box;
  overflow: hidden;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.meta {
  margin-top: 12rpx;
  color: #646a73;
  font-size: 24rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.tag {
  margin-right: 12rpx;
  color: #2f6f62;
}

.summary {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 8rpx;
  color: #646a73;
  font-size: 24rpx;
  line-height: 1.4;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.date {
  margin-top: 8rpx;
  color: #8f959e;
  font-size: 24rpx;
}
