.card {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 32rpx;
  background: #ffffff;
  border-radius: 20rpx;
}

.body {
  flex: 1;
  min-width: 0;
}

.name {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.4;
}

.summary {
  margin-top: 8rpx;
  color: #646a73;
  font-size: 26rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.chevron {
  flex: none;
  margin-left: 24rpx;
  color: #8f959e;
  font-size: 32rpx;
}
