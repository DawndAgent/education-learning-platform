page {
  background: #f6f7f9;
  color: #1f2329;
  font-size: 28rpx;
  line-height: 1.5;
}

.page {
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.title {
  font-size: 40rpx;
  font-weight: 600;
}

.hint {
  margin-top: 12rpx;
  color: #646a73;
}

.entry {
  margin-top: 24rpx;
  padding: 28rpx;
  background: #ffffff;
  border-radius: 16rpx;
}

.entry-name {
  font-size: 32rpx;
  font-weight: 600;
}

.row {
  margin-top: 16rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 12rpx;
}
